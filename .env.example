# Copie este arquivo para .env.hml e .env.prd e preencha com as credenciais de cada ambiente.
# Esses arquivos NÃO vão para o Git (estão no .gitignore).

# Token de parceiro: autentica com os clientes 52 e 19
SCI_PARCEIRO_TOKEN=

# Tokens de sistema (sistema de folha): cada um autentica com o cliente de mesmo número
SCI_SISTEMA_52_TOKEN=
SCI_SISTEMA_19_TOKEN=

# Tokens de cliente
SCI_CLIENTE_52_TOKEN=
SCI_CLIENTE_19_TOKEN=
