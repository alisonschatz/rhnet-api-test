<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console limpo: só avisos e erros. O resultado da execução é exibido pelo resumo
  do projeto (ResumoExecucao) e o detalhe de cada requisição fica nos relatórios.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
